# =============================================================================

# Validates that fun:Error is properly integrated with imo:Error hierarchy
fun-shapes:ErrorSubclassRelationshipShape
    a sh:NodeShape ;
    rdfs:label "Error Subclass Relationship Validation" ;
    rdfs:comment "Validates fun:Error is a subclass of imo:Error. Ensures cross-ontology consistency." ;

@prefix data5g: <http://5g4data.eu/5g4data#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix time: <http://tio.models.tmforum.org/tio/v3.8.0/TimeOntology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Local end-to-end test intent: DE (deploy rusty-llm via mock-inorch) + SE
# (energy monitoring via InSustain). Derived from
# inSustain/example-intent-with-sustainability.ttl on feature/insustain-routing,
# with two local adjustments:
#   * data5g:Application is "rusty-llm" (a valid DNS-1123 namespace label; the
#     example's "LLM inference" contains a space and cannot be a namespace).
#   * DeploymentDescriptor points at the locally packaged chart; mock-inorch
#     installs Workload-Catalog/charts/rusty-llm-0.1.26.tgz regardless.

data5g:Ilocaltest01 a icm:Intent ;
    dct:description "Deploy rusty-llm near Tromso (EC_31) with energy-aware monitoring." ;
    imo:handler "inServ" ;
    imo:owner "inChat" ;
    log:allOf data5g:DElocal01,
        data5g:SElocal01,
        data5g:RElocal01,
        data5g:RElocal02 .

# --- Deployment Expectation -> inOrch (mock-inorch) ---

data5g:COlocalLatency a icm:Condition ;
    dct:description "p99-token-target condition quan:smaller: 400ms" ;
    set:forAll [ icm:valuesOfTargetProperty data5g:p99-token-target_COlocalLatency ;
            quan:smaller [ quan:unit "ms" ;
                    rdf:value 400.0 ] ] .

data5g:CXlocal01 a icm:Context ;
    data5g:Application "rusty-llm" ;
    data5g:DataCenter "EC_31" ;
    data5g:DeploymentDescriptor "urn:helm:rusty-llm:0.1.26" .

data5g:DElocal01 a data5g:DeploymentExpectation,
        icm:Expectation,
        icm:IntentElement ;
    dct:description "Deploy rusty-llm workload near Tromso edge." ;
    icm:target data5g:deployment ;
    log:allOf data5g:COlocalLatency,
        data5g:CXlocal01 .

# --- Sustainability Expectation -> InSustain ---

data5g:COlocalPower a icm:Condition ;
    dct:description "Power consumption must remain below 300 W" ;
    set:forAll [ icm:valuesOfTargetProperty data5g:powerConsumption_COlocalPower ;
            quan:smaller [ quan:unit "W" ;
                    rdf:value 300.0 ] ] .

data5g:COlocalEnergy a icm:Condition ;
    dct:description "Energy consumption must remain below 100000000 J per reporting interval" ;
    set:forAll [ icm:valuesOfTargetProperty data5g:energyConsumption_COlocalEnergy ;
            quan:smaller [ quan:unit "J" ;
                    rdf:value 100000000.0 ] ] .

data5g:SElocal01 a data5g:SustainabilityExpectation,
        icm:Expectation,
        icm:IntentElement ;
    dct:description "Ensure sustainable operation of the rusty-llm workload." ;
    icm:target data5g:sustainability ;
    log:allOf data5g:COlocalPower,
        data5g:COlocalEnergy,
        data5g:CXlocal01 .

# --- Reporting Expectations ---

data5g:tenMinutesDeployment a time:DurationDescription ;
    time:numericDuration "10"^^xsd:decimal ;
    time:unitType time:unitMinute .

data5g:TenMinuteReportEventDeployment a rdfs:Class ;
    rdfs:subClassOf imo:Event ;
    time:delay ( data5g:lastReportInstant data5g:tenMinutesDeployment ) ;
    imo:eventFor data5g:DElocal01 .

data5g:RElocal01 a icm:ObservationReportingExpectation ;
    dct:description "Deployment observation reports every 10 minutes." ;
    icm:target data5g:deployment ;
    icm:reportDestinations [ a rdfs:Container ;
            rdfs:member data5g:prometheus ] ;
    icm:reportTriggers [ a rdfs:Container ;
            rdfs:member data5g:TenMinuteReportEventDeployment ] .

data5g:tenMinutesSustainability a time:DurationDescription ;
    time:numericDuration "10"^^xsd:decimal ;
    time:unitType time:unitMinute .

data5g:TenMinuteReportEventSustainability a rdfs:Class ;
    rdfs:subClassOf imo:Event ;
    time:delay ( data5g:lastReportInstant data5g:tenMinutesSustainability ) ;
    imo:eventFor data5g:SElocal01 .

data5g:RElocal02 a icm:ObservationReportingExpectation ;
    dct:description "Sustainability observation reports every 10 minutes via InSustain." ;
    icm:target data5g:sustainability ;
    icm:reportDestinations [ a rdfs:Container ;
            rdfs:member data5g:insustain ] ;
    icm:reportTriggers [ a rdfs:Container ;
            rdfs:member data5g:TenMinuteReportEventSustainability ] .

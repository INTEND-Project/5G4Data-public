        {
          "datasource": {
            "type": "flandersmake-sparql-datasource",
            "uid": "${DS_FLANDERSMAKE-SPARQL-DATASOURCE}"
          },
          "queryText": "PREFIX icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/>\nPREFIX data5g: <http://5g4data.eu/5g4data#>\nPREFIX t: <http://www.w3.org/2006/time#>\n\nSELECT\n  (REPLACE(STR(?state), \"^.*[/#]\", \"\") AS ?intent_state)\n  ?reportNumber\n  ?generatedAt\nWHERE {\n  BIND(IRI(CONCAT(\"repository:\", \"${repository_id}\")) AS ?__repository)\n  BIND(IRI(\"${graph_iri}\") AS ?__graph)\n  SERVICE ?__repository {\n    GRAPH ?__graph {\n      BIND(data5g:${intent_id} AS ?intent)\n      {\n        SELECT ?intent (MAX(?rn) AS ?maxRn)\n        WHERE {\n          ?r a icm:IntentReport ;\n             icm:about ?intent ;\n             icm:reportNumber ?rn .\n        }\n        GROUP BY ?intent\n      }\n      ?report a icm:IntentReport ;\n              icm:about ?intent ;\n              icm:reportNumber ?maxRn ;\n              icm:intentHandlingState ?state ;\n              icm:reportGenerated ?genNode .\n      BIND(?maxRn AS ?reportNumber)\n      OPTIONAL { ?genNode t:inXSDDateTimeStamp ?ts1 . }\n      OPTIONAL { ?genNode t:inXSDDateTime ?ts2 . }\n      BIND(COALESCE(?ts1, ?ts2, ?genNode) AS ?generatedAt)\n    }\n  }\n}\nLIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Current intent state",
      "type": "table"

# --- tio-shacl/rdf/shapes/IntentProbing.ttl ---
# TMF IntentProbing SHACL Shapes
#
# Domain-specific validation for IntentProbing.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/IntentProbing/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix pro: <http://tio.models.tmforum.org/tio/v3.6.0/IntentProbing/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces
@prefix pro-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/IntentProbing/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# Note: Vocabulary validation handled globally by tio-lib:VocabularyUsageShape in GlobalShapes.ttl

# =============================================================================
# PROPERTY VALIDATION
# =============================================================================

# Validate expectedResult datatype
pro-shapes:ExpectedResultShape
    a sh:NodeShape ;
    rdfs:label "Expected Result Property Validation" ;
    rdfs:comment "Validates that pro:expectedResult has correct datatype" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property pro:expectedResult ;
    ] ;

    sh:property [
        sh:path pro:expectedResult ;
        sh:description "expectedResult must be xsd:boolean" ;
        sh:datatype xsd:boolean ;
        sh:name "expectedResult" ;
        sh:message "[pro/expected_result_type] pro:expectedResult must be xsd:boolean datatype. In TIO v3.6.0, intent probing tests expect true/false outcomes. Add: pro:expectedResult \"true\"^^xsd:boolean or pro:expectedResult \"false\"^^xsd:boolean" ;
    ] ;

    sh:severity sh:Violation .

# Validate expectedObservation range
pro-shapes:ExpectedObservationShape
    a sh:NodeShape ;
    rdfs:label "Expected Observation Property Validation" ;
    rdfs:comment "Validates that pro:expectedObservation points to Observation" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property pro:expectedObservation ;
    ] ;

    sh:property [
        sh:path pro:expectedObservation ;
        sh:description "expectedObservation must point to met:Observation" ;
        sh:class met:Observation ;
        sh:name "expectedObservation" ;
        sh:message "[pro/expected_observation_type] pro:expectedObservation must reference a met:Observation instance. In TIO v3.6.0, probing tests link to expected observation outcomes. Add: pro:expectedObservation <observation-uri> where the resource has rdf:type met:Observation" ;
    ] ;

    sh:severity sh:Violation .

# Note: Global validation (vocabulary, function usage) handled by lib/GlobalShapes.ttl

# --- tio-shacl/rdf/shapes/IntentSpecification.ttl ---
# TMF IntentSpecification SHACL Shapes
#
# Domain-specific validation for IntentSpecification.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix insp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix insp-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/IntentSpecification/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# CONTENT TEMPLATE VALIDATION
# =============================================================================

# Validates ContentTemplate properties
insp-shapes:ContentTemplatePropertiesShape
    a sh:NodeShape ;
    rdfs:label "ContentTemplate Properties Validation" ;
    rdfs:comment "Validates ContentTemplate instances have correct property types." ;
    sh:targetClass insp:ContentTemplate ;
    sh:property [
        sh:path insp:applicableIf ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "[insp/applicable_if_literal] insp:applicableIf must not be a literal." ;
    ] ;
    sh:property [
        sh:path insp:applicableIf ;
        sh:class <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/Condition> ;
        sh:message "[insp/applicable_if_wrong_class] insp:applicableIf must be a log:Condition instance." ;
    ] ;
    sh:property [
        sh:path insp:applicableIfNot ;
        sh:class <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/Condition> ;
        sh:message "[insp/applicable_if_not_type] insp:applicableIfNot must be a log:Condition instance. In TIO v3.6.0, use logical operators to define conditions: [ a log:Condition ; log:allOf ( ... ) ] or [ a log:Condition ; log:match ( ... ) ]. Example: insp:applicableIfNot [ a log:Condition ; log:match ( property value ) ]" ;
    ] ;
    sh:property [
        sh:path insp:content ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:message "[insp/content_literal] insp:content must be a resource (blank node or IRI), not a literal value. In TIO v3.6.0, insp:content references Intent or Expectation templates as structured resources. Use blank nodes [ ... ] or named URIs, not strings." ;
    ] ;
    sh:property [
        sh:path insp:contentUsing ;
        sh:class insp:VocabularyTemplate ;
        sh:message "[insp/content_using_not_vocab_template] insp:contentUsing must be an insp:VocabularyTemplate instance. In TIO v3.6.0, use VocabularyTemplate to define custom vocabularies for template content. Add: a insp:VocabularyTemplate to the referenced resource." ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# INTENT SPECIFICATION VALIDATION
# =============================================================================

# Validates IntentSpecification properties
insp-shapes:IntentSpecificationPropertiesShape
    a sh:NodeShape ;
    rdfs:label "IntentSpecification Properties Validation" ;
    rdfs:comment "Validates IntentSpecification instances have correct property types." ;
    sh:targetClass insp:IntentSpecification ;
    sh:property [
        sh:path insp:mandatoryIntent ;
        sh:class <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/Intent> ;
        sh:message "[insp/mandatory_not_intent] insp:mandatoryIntent must be an icm:Intent instance. In TIO v3.6.0, IntentSpecification templates reference actual Intent instances (icm:Intent or subclasses like icm:AtomicIntent). Ensure the referenced resource has: a icm:Intent or a icm:AtomicIntent." ;
    ] ;
    sh:property [
        sh:path insp:mandatorySpecification ;
        sh:class insp:IntentSpecification ;
        sh:message "[insp/mandatory_spec_type] insp:mandatorySpecification must be an insp:IntentSpecification instance. In TIO v3.6.0, IntentSpecifications can be nested to create hierarchical templates. Ensure the referenced resource has: a insp:IntentSpecification." ;
    ] ;
    sh:property [
        sh:path insp:optionalIntent ;
        sh:class <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/Intent> ;
        sh:message "[insp/optional_not_intent] insp:optionalIntent must be an icm:Intent instance. In TIO v3.6.0, IntentSpecification templates can include optional Intent components. Ensure the referenced resource has: a icm:Intent or a icm:AtomicIntent." ;
    ] ;
    sh:property [
        sh:path insp:optionalSpecification ;
        sh:class insp:IntentSpecification ;
        sh:message "[insp/optional_spec_type] insp:optionalSpecification must be an insp:IntentSpecification instance. In TIO v3.6.0, IntentSpecifications can include optional nested specifications for flexible template composition. Ensure the referenced resource has: a insp:IntentSpecification." ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# OBJECT TEMPLATE VALIDATION
# =============================================================================

# Validates ObjectTemplate properties
insp-shapes:ObjectTemplatePropertiesShape
    a sh:NodeShape ;
    rdfs:label "ObjectTemplate Properties Validation" ;
    rdfs:comment "Validates ObjectTemplate instances have correct property types." ;
    sh:targetClass insp:ObjectTemplate ;
    sh:property [
        sh:path insp:allowedValues ;
        sh:class rdfs:Container ;
        sh:message "[insp/allowed_values_type] insp:allowedValues must be an rdfs:Container (rdf:Bag, rdf:Seq, or rdf:Alt). In TIO v3.6.0, use RDF containers to enumerate valid values for template parameters. Example: insp:allowedValues [ a rdf:Bag ; rdf:_1 \"value1\" ; rdf:_2 \"value2\" ] or use RDF lists for simpler cases." ;
    ] ;
    sh:property [
        sh:path insp:templateType ;
        sh:nodeKind sh:IRI ;
        sh:message "[insp/template_type_literal] insp:templateType must be an IRI (class reference), not a literal string. Got: {$value}. In TIO v3.6.0, templateType references the RDF class that template instances will belong to. Use IRI references like icm:PropertyExpectation, quan:Quantity, not string literals like \"PropertyExpectation\"." ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/IntentValidityOntology.ttl ---
# TMF IntentValidityOntology SHACL Shapes
#
# Domain-specific validation for IntentValidityOntology.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix iv: <http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces
@prefix iv-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/IntentValidityOntology/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# Note: Vocabulary validation handled globally by tio-lib:VocabularyUsageShape in GlobalShapes.ttl

# =============================================================================
# PROPERTY VALIDATION
# =============================================================================

# Validate isValid datatype
iv-shapes:IsValidShape
    a sh:NodeShape ;
    rdfs:label "Is Valid Property Validation" ;
    rdfs:comment "Validates that iv:isValid has correct datatype" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property iv:isValid ;
    ] ;

    sh:property [
        sh:path iv:isValid ;
        sh:description "isValid must be xsd:boolean" ;
        sh:datatype xsd:boolean ;
        sh:name "isValid" ;
        sh:message "[iv/is_valid_type] iv:isValid must be of datatype xsd:boolean" ;
    ] ;

    sh:severity sh:Violation .

# Validate validIf class range
iv-shapes:ValidIfShape
    a sh:NodeShape ;
    rdfs:label "Valid If Property Validation" ;
    rdfs:comment "Validates that iv:validIf values are instances of iv:Validity" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property iv:validIf ;
    ] ;

    sh:property [
        sh:path iv:validIf ;
        sh:description "validIf must be an iv:Validity instance" ;
        sh:class iv:Validity ;
        sh:name "validIf" ;
        sh:message "[iv/valid_if_not_validity] iv:validIf must reference an instance of iv:Validity. For temporal constraints, create a Validity that is also a log:Condition: [ a iv:Validity, log:Condition ; log:allOf ( ... ) ]. Use W3C Time ontology (t:inDateTime, t:dayOfWeek, t:inTimeInterval) with imo:Now to express time constraints. Do NOT invent properties like icm:validDuring, icm:dayMask, icm:startTime - these do not exist in TIO v3.6.0." ;
    ] ;

    sh:severity sh:Violation .

# Validate sameValidityAs class range
# Must be Intent or Expectation (which can have validity), not other IntentElements like Target
# Uses ValidityCandidate extension - RDFS inference handles subclass checking
# Simplified from SPARQL to sh:class (requires inference='rdfs' in PySHACL)
iv-shapes:SameValidityAsShape
    a sh:NodeShape ;
    rdfs:label "Same Validity As Property Validation" ;
    rdfs:comment "Validates that iv:sameValidityAs values are instances of iv:ValidityCandidate (Intent or Expectation)" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property iv:sameValidityAs ;
    ] ;
    sh:property [
        sh:path iv:sameValidityAs ;
        sh:class iv:ValidityCandidate ;
        sh:message "[iv/same_validity_as_type] iv:sameValidityAs must reference a ValidityCandidate (Intent or Expectation)" ;
    ] ;
    sh:severity sh:Violation .

# Note: Function usage validation handled globally by tio-lib:FunctionUsageShape in GlobalShapes.ttl

# =============================================================================
# INTENT VALIDITY VALIDATION
# =============================================================================

# Validate Intent Validity classes and functions
iv-shapes:IntentValidityShape
    a sh:NodeShape ;
    rdfs:label "Intent Validity Shape" ;
    rdfs:comment "Validates Intent Validity ontology elements" ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/" ;
        tio-lib:targetClass rdfs:Class ;
    ] ;

    # Apply shared constraints for intent validity class documentation
    sh:sparql tio-constraints:ClassDocumentationConstraint ;

    sh:severity sh:Warning .

# Note: Global validation (vocabulary, function usage) handled by lib/GlobalShapes.ttl

# --- tio-shacl/rdf/shapes/LogicalOperators.ttl ---
# TMF LogicalOperators SHACL Shapes
#
# Domain-specific validation for LogicalOperators.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix log-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/LogicalOperators/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# LOGICAL FUNCTION RESULT TYPE VALIDATION
# =============================================================================

# Validates logical operator functions return boolean
log-shapes:LogicalFunctionResultTypeShape
    a sh:NodeShape ;
    rdfs:label "Logical Function Result Type Validation" ;
    rdfs:comment "Validates logical operator functions have xsd:boolean as resultType." ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/" ;
        tio-lib:targetClass fun:Function ;
    ] ;
    
    sh:sparql tio-constraints:FunctionBooleanResultTypeConstraint ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/MathFunctions.ttl ---
# TMF MathFunctions SHACL Shapes
#
# Domain-specific validation for MathFunctions.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix mf: <http://tio.models.tmforum.org/tio/v3.6.0/MathFunctions/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix mf-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/MathFunctions/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# LOGISTIC FUNCTION INSTANCE VALIDATION
# =============================================================================

# Validates logistic function instances have required parameters
mf-shapes:LogisticFunctionParametersShape
    a sh:NodeShape ;
    rdfs:label "Logistic Function Parameters Validation" ;
    rdfs:comment "Validates logistic function instances have required k parameter." ;
    sh:targetClass mf:logistic ;

    sh:property [
        sh:path mf:k ;
        sh:minCount 1 ;
        sh:message "[mf/logistic_missing_k] Logistic function missing required mf:k parameter. In TIO v3.6.0, mf:logistic instances must define the steepness parameter k. Add: mf:k \"2.5\"^^xsd:decimal. The logistic function maps inputs using the formula: 1 / (1 + e^(-k*x))." ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# MAPPING FUNCTION INSTANCE VALIDATION
# =============================================================================

# Validates mapping function instances have required parameters
mf-shapes:MappingFunctionParametersShape
    a sh:NodeShape ;
    rdfs:label "Mapping Function Parameters Validation" ;
    rdfs:comment "Validates mapping function instances have required map parameter." ;
    sh:targetClass mf:mapping ;

    sh:property [
        sh:path mf:map ;
        sh:minCount 1 ;
        sh:message "[mf/mapping_missing_map] Mapping function missing required mf:map parameter. In TIO v3.6.0, mf:mapping instances must define the mapping table. Add: mf:map ( (input1 output1) (input2 output2) ... ). Example: [ a mf:mapping ; mf:map ( (\"low\" 1) (\"medium\" 5) (\"high\" 10) ) ]" ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/MetricsAndObservations.ttl ---
# TMF MetricsAndObservations SHACL Shapes
#
# Domain-specific validation for MetricsAndObservations.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix met: <http://tio.models.tmforum.org/tio/v3.6.0/MetricsAndObservations/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix met-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/MetricsAndObservations/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# Note: Function definition validation handled globally by tio-lib:FunctionDefinitionShape in GlobalShapes.ttl

# =============================================================================
# OBSERVATION CLASS VALIDATION
# =============================================================================

# Validates Observation instances have required properties
met-shapes:ObservationPropertiesShape
    a sh:NodeShape ;
    rdfs:label "Observation Properties Validation" ;
    rdfs:comment "Validates Observation instances have required properties with correct types." ;
    sh:targetClass met:Observation ;
    sh:property [
        sh:path met:observedMetric ;
        sh:minCount 1 ;
        sh:message "[met/missing_observed_metric] Observation missing required met:observedMetric. Every met:Observation in TIO v3.6.0 must reference the metric being observed. Add: met:observedMetric <yourMetric>. Example: [ a met:Observation ; met:observedMetric ex:cpuUsage ; met:obtainedAt \"2024-01-01T12:00:00Z\"^^xsd:dateTime ; met:value \"75%\"^^quan:quantity ]" ;
    ] ;
    sh:property [
        sh:path met:obtainedAt ;
        sh:datatype xsd:dateTime ;
        sh:message "[met/obtained_at_type] met:obtainedAt must be xsd:dateTime. Got: {$value}. In TIO v3.6.0, observation timestamps must use proper XSD dateTime format. Fix: met:obtainedAt \"2024-01-01T12:00:00Z\"^^xsd:dateTime or \"2024-01-01T12:00:00-05:00\"^^xsd:dateTime with timezone." ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/PreferenceOfHandlingOutcomes.ttl ---
# TMF PreferenceOfHandlingOutcomes SHACL Shapes
#
# Domain-specific validation for PreferenceOfHandlingOutcomes.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/PreferenceOfHandlingOutcomes/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix pre: <http://tio.models.tmforum.org/tio/v3.6.0/PreferenceOfHandlingOutcomes/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces
@prefix pre-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/PreferenceOfHandlingOutcomes/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# JUDGEMENT REQUEST VALIDATION
# =============================================================================

pre-shapes:JudgementRequestShape
    a sh:NodeShape ;
    rdfs:label "Judgement Request Shape" ;
    rdfs:comment "Validates JudgementRequest class instances. Judgement requests solicit intent owner preferences on available solution options by presenting expected outcomes via intent reports." ;
    sh:targetClass pre:JudgementRequest ;

    # preferenceDeadline: time limit for receiving preference statements
    sh:property [
        sh:path pre:preferenceDeadline ;
        sh:class <http://www.w3.org/2006/time#Instant> ;
        sh:maxCount 1 ;
        sh:name "preferenceDeadline" ;
        sh:description "Point in time until preference must be provided" ;
        sh:message "[pre/deadline_not_instant] pre:preferenceDeadline must be a time:Instant when present. In TIO v3.6.0, use W3C Time ontology to specify when preference must be submitted. Example: pre:preferenceDeadline [ a time:Instant ; time:inXSDDateTimeStamp \"2024-01-01T12:00:00Z\"^^xsd:dateTimeStamp ]" ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/judgement_request] JudgementRequest validation failed: ensure preferenceDeadline is a time:Instant if specified" .

# =============================================================================
# PREFERENCE VALIDATION
# =============================================================================

pre-shapes:PreferenceShape
    a sh:NodeShape ;
    rdfs:label "Preference Shape" ;
    rdfs:comment "Validates Preference class instances. Preferences express intent owner judgements about solution alternatives presented in judgement requests." ;
    sh:targetClass pre:Preference ;

    # about: reference to the judgement request
    sh:property [
        sh:path pre:about ;
        sh:class pre:JudgementRequest ;
        sh:name "about" ;
        sh:description "Judgement request this preference responds to" ;
        sh:message "[pre/about_type] pre:about must be a pre:JudgementRequest instance. In TIO v3.6.0, preferences respond to judgement requests. Ensure: pre:about <request-uri> where the URI has rdf:type pre:JudgementRequest" ;
    ] ;

    # neutral: intent reports without strong preference
    sh:property [
        sh:path pre:neutral ;
        sh:class icm:IntentReport ;
        sh:name "neutral" ;
        sh:description "Intent reports the owner neither prefers nor objects to" ;
        sh:message "[domain/pre_neutral_type] pre:neutral must be an icm:IntentReport instance when present" ;
    ] ;

    # objected: problematic intent reports to avoid
    sh:property [
        sh:path pre:objected ;
        sh:class icm:IntentReport ;
        sh:name "objected" ;
        sh:description "Intent reports the owner considers problematic and should be avoided" ;
        sh:message "[domain/pre_objected_type] pre:objected must be an icm:IntentReport instance when present" ;
    ] ;

    # preferred: desirable intent reports
    sh:property [
        sh:path pre:preferred ;
        sh:class icm:IntentReport ;
        sh:name "preferred" ;
        sh:description "Intent reports the owner considers preferential" ;
        sh:message "[pre/preferred_type] pre:preferred must be an icm:IntentReport instance when present" ;
    ] ;

    # score: quantified preference scores
    sh:property [
        sh:path pre:score ;
        sh:class pre:PreferenceScore ;
        sh:name "score" ;
        sh:description "Numerical scores quantifying preferences for options" ;
        sh:message "[pre/score_type] pre:score must be a pre:PreferenceScore instance when present" ;
    ] ;

    # scoreInterpretation: how to interpret score values
    sh:property [
        sh:path pre:scoreInterpretation ;
        sh:class pre:ScoreInterpretation ;
        sh:name "scoreInterpretation" ;
        sh:description "Interpretation guidance for preference scores" ;
        sh:message "[domain/pre_score_interpretation_type] pre:scoreInterpretation must be a pre:ScoreInterpretation instance when present" ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/preference_properties] Preference validation failed: ensure all preference properties reference correct class instances (JudgementRequest, IntentReport, PreferenceScore, ScoreInterpretation)" .

# =============================================================================
# PREFERENCE SCORE VALIDATION
# =============================================================================

pre-shapes:PreferenceScoreShape
    a sh:NodeShape ;
    rdfs:label "Preference Score Shape" ;
    rdfs:comment "Validates PreferenceScore class instances. Preference scores quantify intent owner preferences for specific solution options with numerical values." ;
    sh:targetClass pre:PreferenceScore ;

    # aboutOption: which intent report this score applies to
    sh:property [
        sh:path pre:aboutOption ;
        sh:class icm:IntentReport ;
        sh:name "aboutOption" ;
        sh:description "Intent report being scored" ;
        sh:message "[pre/about_option_type] pre:aboutOption must be an icm:IntentReport instance when present" ;
    ] ;

    # scoreValue: the numerical score
    sh:property [
        sh:path pre:scoreValue ;
        sh:nodeKind sh:Literal ;
        sh:name "scoreValue" ;
        sh:description "Numerical value representing preference strength" ;
        sh:message "[pre/score_value_type] pre:scoreValue must be a literal value (typically numeric). In TIO v3.6.0, scores quantify preference strength. Example: pre:scoreValue \"85\"^^xsd:decimal or pre:scoreValue \"4.5\"^^xsd:double" ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/preference_score] PreferenceScore validation failed: ensure aboutOption references an IntentReport and scoreValue is a literal" .

# =============================================================================
# SCORE INTERPRETATION VALIDATION
# =============================================================================

pre-shapes:ScoreInterpretationShape
    a sh:NodeShape ;
    rdfs:label "Score Interpretation Shape" ;
    rdfs:comment "Validates ScoreInterpretation class instances. Score interpretations define thresholds and bounds for understanding numerical preference scores." ;
    sh:targetClass pre:ScoreInterpretation ;

    # maxScore: maximum/full score value
    sh:property [
        sh:path pre:maxScore ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:name "maxScore" ;
        sh:description "Maximum score value used in preferences" ;
        sh:message "[pre/score_not_literal] pre:maxScore must be a literal value (typically numeric) when present" ;
    ] ;

    # minScore: minimum score value
    sh:property [
        sh:path pre:minScore ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:name "minScore" ;
        sh:description "Minimum score value used in preferences (default 0 if not specified)" ;
        sh:message "[pre/score_not_literal] pre:minScore must be a literal value (typically numeric) when present" ;
    ] ;

    # objectedThreshold: maximum score for objected options
    sh:property [
        sh:path pre:objectedThreshold ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:name "objectedThreshold" ;
        sh:description "Maximum score for objected options (scores below this should be avoided)" ;
        sh:message "[pre/score_not_literal] pre:objectedThreshold must be a literal value (typically numeric) when present" ;
    ] ;

    # preferredThreshold: minimum score for preferred options
    sh:property [
        sh:path pre:preferredThreshold ;
        sh:nodeKind sh:Literal ;
        sh:maxCount 1 ;
        sh:name "preferredThreshold" ;
        sh:description "Minimum score for preferred options (scores at or above this are preferred)" ;
        sh:message "[pre/score_not_literal] pre:preferredThreshold must be a literal value (typically numeric) when present" ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/score_interpretation] ScoreInterpretation validation failed: ensure all threshold and bound values (maxScore, minScore, objectedThreshold, preferredThreshold) are literals" .

# Note: Vocabulary validation handled globally by tio-lib:VocabularyUsageShape in GlobalShapes.ttl

# --- tio-shacl/rdf/shapes/ProposalBestIntent.ttl ---
# TMF ProposalBestIntent SHACL Shapes
#
# Domain-specific validation for ProposalBestIntent.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix pbi: <http://tio.models.tmforum.org/tio/v3.6.0/ProposalBestIntent/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces
@prefix pbi-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/ProposalBestIntent/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# BEST PROPOSAL REPORT VALIDATION
# =============================================================================

pbi-shapes:BestProposalReportShape
    a sh:NodeShape ;
    rdfs:label "Best Proposal Report Shape" ;
    rdfs:comment "Validates BestProposalReport class instances. Best proposal reports contain individual proposals responding to best proposal expectations in intents." ;
    sh:targetClass pbi:BestProposalReport ;

    # proposed: individual proposals in the report
    sh:property [
        sh:path pbi:proposed ;
        sh:class pbi:Proposal ;
        sh:name "proposed" ;
        sh:description "Individual proposals contained in this report" ;
        sh:message "[pbi/proposed_literal] pbi:proposed must be a pbi:Proposal instance. In TIO v3.6.0, best proposal reports contain individual proposals for each requirement. Ensure: pbi:proposed <proposal-uri> where the URI has rdf:type pbi:Proposal" ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/best_proposal_report] BestProposalReport validation failed: ensure all proposed entries are pbi:Proposal instances" .

# =============================================================================
# PROPOSAL VALIDATION
# =============================================================================

pbi-shapes:ProposalShape
    a sh:NodeShape ;
    rdfs:label "Proposal Shape" ;
    rdfs:comment "Validates Proposal class instances. Proposals provide suggested values for specific intent requirements, typically one proposal per requirement within the scope." ;
    sh:targetClass pbi:Proposal ;

    # proposedFor: which requirement this proposal addresses
    sh:property [
        sh:path pbi:proposedFor ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "proposedFor" ;
        sh:description "The intent requirement object this proposal addresses" ;
        sh:message "[pbi/proposed_for_literal] pbi:proposedFor must be a resource (blank node or IRI) referencing an intent requirement when present" ;
    ] ;

    # proposedBest: the proposed values
    sh:property [
        sh:path pbi:proposedBest ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "proposedBest" ;
        sh:description "Object containing the proposed values" ;
        sh:message "[pbi/proposed_best_literal] pbi:proposedBest must be a resource (blank node or IRI), not a literal. In TIO v3.6.0, this contains structured proposal values. Use blank nodes [ ... ] or named URIs for complex objects, not strings or numbers directly." ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/proposal_properties] Proposal validation failed: ensure proposedFor references an intent requirement and proposedBest contains the proposal values" .

# Note: Vocabulary validation handled globally by tio-lib:VocabularyUsageShape in GlobalShapes.ttl

# --- tio-shacl/rdf/shapes/QuantityOntology.ttl ---
# TMF QuantityOntology SHACL Shapes
#
# Domain-specific validation for QuantityOntology.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix quan-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/QuantityOntology/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# QUANTITY CLASS VALIDATION
# =============================================================================

# Validates Quantity instances have value and unit
quan-shapes:QuantityValueUnitShape
    a sh:NodeShape ;
    rdfs:label "Quantity Value and Unit Validation" ;
    rdfs:comment "Validates Quantity instances have rdf:value and quan:unit (unless computed by function)." ;
    sh:targetClass quan:Quantity ;
    sh:sparql tio-constraints:QuantityMissingValueConstraint ;
    sh:property [
        sh:path rdf:value ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:float ]
            [ sh:datatype xsd:double ]
        ) ;
        sh:message "[quan/value_not_numeric] Quantity must have exactly one numeric rdf:value (decimal, integer, float, or double). Use quan:quantity datatype literals for inline quantities: \"320kbps\"^^quan:quantity. For comparisons, use quantity functions like quan:atLeast, quan:atMost with met:lastValue for metrics." ;
    ] ;
    sh:property [
        sh:path quan:unit ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "[quan/unit_type] Quantity unit must be a string and appear at most once" ;
    ] ;
    sh:severity sh:Violation .

# Validates Quantity values are non-negative
# Simplified: Using SHACL core sh:minInclusive instead of SPARQL
quan-shapes:QuantityNonNegativeValueShape
    a sh:NodeShape ;
    rdfs:label "Quantity Non-Negative Value Validation" ;
    rdfs:comment "Validates Quantity instances have non-negative rdf:value." ;
    sh:targetClass quan:Quantity ;
    sh:property [
        sh:path rdf:value ;
        sh:minInclusive 0 ;
        sh:message "[quan/negative_value] Quantity value must be non-negative (>= 0). Got: {$value}" ;
    ] ;
    sh:severity sh:Violation .

# Validates MonetaryQuantity has valid currency code
quan-shapes:MonetaryCurrencyCodeShape
    a sh:NodeShape ;
    rdfs:label "Monetary Currency Code Validation" ;
    rdfs:comment "Validates MonetaryQuantity instances have ISO 4217 currency code as unit." ;
    sh:targetClass quan:MonetaryQuantity ;
    sh:property [
        sh:path quan:unit ;
        sh:pattern "^[A-Z]{3}$" ;
        sh:message "[quan/currency_code_invalid] MonetaryQuantity unit must be 3-letter ISO 4217 currency code (e.g., USD, EUR, GBP). Got: {$value}" ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# QUANTITY COMPARISON FUNCTION RESULT TYPE VALIDATION
# =============================================================================

# Validates quantity comparison functions return boolean
quan-shapes:QuantityComparisonFunctionResultTypeShape
    a sh:NodeShape ;
    rdfs:label "Quantity Comparison Function Result Type Validation" ;
    rdfs:comment "Validates quantity comparison functions (atLeast, atMost, equals, etc.) have xsd:boolean as resultType." ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/" ;
        tio-lib:targetClass fun:Function ;
    ] ;
    
    sh:sparql tio-constraints:QuantityComparisonFunctionBooleanResultTypeConstraint ;
    sh:severity sh:Violation .

# =============================================================================
# PROPERTY DOMAIN VALIDATION
# =============================================================================

# Validates quan:unit property is only used on Quantity instances
quan-shapes:DomainOfQuantityPropertiesShape
    a sh:NodeShape ;
    rdfs:label "Domain Validation for quan:unit Property" ;
    rdfs:comment "Validates quan:unit is only used on quan:Quantity instances." ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property quan:unit ;
    ] ;

    sh:class quan:Quantity ;
    sh:message "[quan/unit_domain] quan:unit property may only be used on quan:Quantity instances" ;
    sh:severity sh:Violation .

# Validates rdfs:label has correct datatype
quan-shapes:LabelDatatypeShape
    a sh:NodeShape ;
    rdfs:label "Label Datatype Validation" ;
    rdfs:comment "Validates rdfs:label has xsd:string or rdf:langString datatype." ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property rdfs:label ;
    ] ;

    sh:property [
        sh:path rdfs:label ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "[domain/label_type] rdfs:label must be xsd:string or rdf:langString. Got: {$value}" ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/SetOperators.ttl ---
# TMF SetOperators SHACL Shapes
#
# Domain-specific validation for SetOperators.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix set-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/SetOperators/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# SET MEMBERSHIP FUNCTION RESULT TYPE VALIDATION
# =============================================================================

# Validates set membership functions return boolean
set-shapes:SetMembershipFunctionResultTypeShape
    a sh:NodeShape ;
    rdfs:label "Set Membership Function Result Type Validation" ;
    rdfs:comment "Validates set membership functions (elementOf, includedIn, intersectsWith) have xsd:boolean as resultType." ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/" ;
        tio-lib:targetClass fun:Function ;
    ] ;
    
    sh:sparql tio-constraints:SetMembershipFunctionBooleanResultTypeConstraint ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape

# --- tio-shacl/rdf/shapes/Utility.ttl ---
# TMF Utility SHACL Shapes
#
# Domain-specific validation for Utility.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/Utility/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix ut: <http://tio.models.tmforum.org/tio/v3.6.0/Utility/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces
@prefix ut-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/Utility/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# UTILITY INFORMATION VALIDATION
# =============================================================================

ut-shapes:UtilityInformationShape
    a sh:NodeShape ;
    rdfs:label "Utility Information Shape" ;
    rdfs:comment "Validates UtilityInformation class instances. Utility information specifies utility functions and their arguments for calculating utility scores that quantify business value." ;
    sh:targetClass ut:UtilityInformation ;

    # forMetric: maps function arguments to metrics
    sh:property [
        sh:path ut:forMetric ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "forMetric" ;
        sh:description "Value pair mapping argument B-node to metric (specifies metrics for utility function)" ;
        sh:message "[ut/for_metric_literal] ut:forMetric must be an RDF list containing [argument, metric] pairs. In TIO v3.6.0, use Turtle list syntax: ut:forMetric ( [blank-node-arg] <metric-uri> ). This maps utility function arguments to metrics for data binding." ;
    ] ;

    # function: the utility function to calculate scores
    sh:property [
        sh:path ut:function ;
        sh:nodeKind sh:IRI ;
        sh:message "[ut/function_literal] ut:function must be an IRI, not a literal." ;
    ] ;
    sh:property [
        sh:path ut:function ;
        sh:class fun:Function ;
        sh:message "[ut/function_not_function] ut:function must reference a fun:Function instance." ;
    ] ;

    # withArgument: single argument value assignment
    sh:property [
        sh:path ut:withArgument ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "withArgument" ;
        sh:description "Value pair [named-argument, value] for single argument assignment" ;
        sh:message "[domain/utility_with_argument] ut:withArgument must be a list (use Turtle () syntax) containing [argument-name, value] when present" ;
    ] ;

    # withArguments: complete argument list
    sh:property [
        sh:path ut:withArguments ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:name "withArguments" ;
        sh:description "Complete argument list matching function's argument specification" ;
        sh:message "[domain/utility_with_arguments] ut:withArguments must be an RDF list of values. In TIO v3.6.0, use Turtle list syntax to provide all function arguments: ut:withArguments ( value1 value2 value3 ). The list length must match the function's arity." ;
    ] ;

    sh:severity sh:Violation ;
    sh:message "[domain/utility_information] UtilityInformation validation failed: ensure function is fun:Function, forMetric/withArgument/withArguments are rdf:List instances with correct structure" .

# Note: Vocabulary validation handled globally by tio-lib:VocabularyUsageShape in GlobalShapes.ttl

# =============================================================================
# PROPERTY RANGE VALIDATION
# =============================================================================

# Validate ut:function property range
ut-shapes:FunctionPropertyShape
    a sh:NodeShape ;
    rdfs:label "Function Property Range Validation" ;
    rdfs:comment "Validates that ut:function points to fun:Function" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property ut:function ;
    ] ;

    sh:property [
        sh:path ut:function ;
        sh:description "function must point to fun:Function" ;
        sh:class fun:Function ;
        sh:name "function" ;
        sh:message "[ut/function_literal, ut/function_not_function] ut:function must reference a fun:Function instance. In TIO v3.6.0, utility calculations use functions from FunctionOntology or MathFunctions. Ensure the referenced URI has rdf:type fun:Function." ;
    ] ;

    sh:severity sh:Violation .

# Validate ut:utility property range
ut-shapes:UtilityPropertyShape
    a sh:NodeShape ;
    rdfs:label "Utility Property Range Validation" ;
    rdfs:comment "Validates that ut:utility points to UtilityInformation" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property ut:utility ;
    ] ;

    sh:property [
        sh:path ut:utility ;
        sh:description "utility must point to ut:UtilityInformation" ;
        sh:class ut:UtilityInformation ;
        sh:name "utility" ;
        sh:nodeKind sh:IRI ;
        sh:message "[ut/utility_literal] ut:utility must be an IRI, not a literal." ;
    ] ;
    sh:property [
        sh:path ut:utility ;
        sh:class ut:UtilityInformation ;
        sh:message "[ut/utility_not_info] ut:utility must reference a ut:UtilityInformation instance." ;
    ] ;

    sh:severity sh:Violation .

# Note: Function definition validation handled globally by tio-lib:FunctionDefinitionShape in GlobalShapes.ttl


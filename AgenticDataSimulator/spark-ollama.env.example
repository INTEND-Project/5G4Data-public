# Ollama OpenAI-compatible API on spark-88e2 over Tailscale (no auth).
# On the Spark, Ollama must listen beyond localhost, e.g.:
#   OLLAMA_HOST=0.0.0.0:11434
# or proxy with: tailscale serve --tcp=11434 tcp://127.0.0.1:11434

export OPENAI_BASE_URL="http://spark-88e2.taile6732f.ts.net:11434/v1"
export OPENAI_MODEL="gpt-oss:20b"
# Optional; Ollama ignores this when auth is disabled.
export OPENAI_API_KEY="ollama"

# =============================================================================

# Validates icm:about property values are IRIs
# Note: Uses inline SPARQL target instead of SubjectsOfPropertyTargetType due to pyshacl timing bug
# (pyshacl registers SPARQLTargetType after shapes are loaded)
icm-shapes:AboutPropertyRangeShape
    a sh:NodeShape ;
    rdfs:label "Range Validation for icm:about" ;
    rdfs:comment "Validates icm:about values are IRI references, not literals." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/>
            SELECT ?this
            WHERE {
                ?this icm:about ?value .
            }
        """ ;
    ] ;
    sh:property [
        sh:path icm:about ;
        sh:nodeKind sh:IRI ;
        sh:message "[icm/about_must_be_iri] icm:about must be an IRI (resource reference), not a literal. Got: {$value}" ;
    ] ;
    sh:severity sh:Violation .

# =============================================================================
# PROPERTY DOMAIN AND RANGE VALIDATION
# =============================================================================

# Validates icm:target is only used on Expectation instances
# Note: Uses inline SPARQL target instead of SubjectsOfPropertyTargetType due to pyshacl timing bug
# (pyshacl registers SPARQLTargetType after shapes are loaded)
icm-shapes:DomainOfTargetPropertyShape
    a sh:NodeShape ;
    rdfs:label "Domain Validation for icm:target" ;
    rdfs:comment "Validates icm:target is only used on icm:Expectation instances." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/>
            SELECT ?this
            WHERE {
                ?this icm:target ?value .
            }
        """ ;
    ] ;
    sh:class icm:Expectation ;
    sh:message "[icm/target_domain] icm:target may only be used on icm:Expectation instances (DeliveryExpectation, PropertyExpectation, ReportingExpectation, etc.). If you need temporal constraints, create a Validity instance separately and link it with iv:validIf on the Intent, NOT using icm:target on the Validity. Classes like icm:TemporalExpectation and icm:TimeWindow do NOT exist in TIO v3.6.0." ;
    sh:severity sh:Violation .

# Validates Expectation instances have required target
icm-shapes:ExpectationTargetShape
    a sh:NodeShape ;
    rdfs:label "Expectation Target Validation" ;
    rdfs:comment "Validates Expectation instances have at least one icm:target of type icm:Target." ;
    sh:targetClass icm:Expectation ;
    sh:property [
        sh:path icm:target ;
        sh:class icm:Target ;
        sh:minCount 1 ;
        sh:message "[icm/missing_target] Expectation missing required icm:target. Add: icm:target <target-resource> where <target-resource> is an instance of icm:Target (e.g., ex:customTarget a icm:Target)" ;
    ] ;
    sh:severity sh:Violation .

# Validates DeliveryExpectation properties
icm-shapes:DeliveryExpectationPropertiesShape
    a sh:NodeShape ;
    rdfs:label "DeliveryExpectation Properties Validation" ;
    rdfs:comment "Validates DeliveryExpectation instances have correct property types." ;
    sh:targetClass icm:DeliveryExpectation ;
    sh:property [
        sh:path icm:deliveryType ;
        sh:nodeKind sh:IRI ;

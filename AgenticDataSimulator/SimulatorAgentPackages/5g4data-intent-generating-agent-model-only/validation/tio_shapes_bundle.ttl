# =============================================================================

# Validates that BooleanFunction definitions return boolean type
fun-shapes:BooleanFunctionResultTypeShape
    a sh:NodeShape ;
    rdfs:label "Boolean Function Result Type Validation" ;
    rdfs:comment "Validates fun:BooleanFunction instances have xsd:boolean as resultType. Type consistency check." ;
    sh:message """[domain/boolean_function_resulttype] BooleanFunction must have fun:resultType xsd:boolean. Found: {$value}. Example: log:and a fun:BooleanFunction ; fun:resultType xsd:boolean .""" ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/" ;
        tio-lib:targetClass fun:BooleanFunction ;
    ] ;
    
    sh:property [
        sh:path fun:resultType ;
        sh:hasValue xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    
    sh:severity sh:Violation .

# =============================================================================
# PROPERTY DOMAIN VALIDATION
# =============================================================================

# Validates that function properties are only used on fun:Function instances
fun-shapes:DomainOfFunctionPropertiesShape
    a sh:NodeShape ;
    rdfs:label "Domain Validation for Function Properties" ;
    rdfs:comment "Validates function-specific properties are only used on fun:Function instances. Enforces rdfs:domain constraints." ;
    sh:message """[domain/function_domain] Function property (fun:arityMin, fun:arityMax, fun:resultType, etc.) used on non-Function resource. Add 'a fun:Function' or remove the function properties. Bad: ex:myIntent a icm:Intent ; fun:arityMin 2 . Good: math:add a fun:Function ; fun:arityMin 2 .""" ;
    sh:target [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:arityMin ;
    ], [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:arityMax ;
    ], [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:argumentNames ;
    ], [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:argumentTypes ;
    ], [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:resultType ;
    ], [
        a tio-targets:SubjectsOfPropertyTargetType ;
        tio-lib:property fun:resultIfInvalid ;
    ] ;
    
    sh:class fun:Function ;
    sh:severity sh:Violation .

# =============================================================================

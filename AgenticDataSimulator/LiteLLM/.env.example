# Copy to .env and fill in.
# Master key required by the proxy on every request. Use the SAME value
# for OPENAI_API_KEY in each simulator agent clone .env.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-CHANGE-ME

# AWS SSO profile from ~/.aws/config. Must be logged in via `aws sso login`.
# Replace with your own profile name.
AWS_PROFILE=CHANGE-ME

# Bedrock region — must be a region where the Claude models above are available
# for the Ericsson account.
AWS_REGION=eu-central-1

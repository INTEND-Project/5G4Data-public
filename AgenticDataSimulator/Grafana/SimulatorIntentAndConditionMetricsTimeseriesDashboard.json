      "targets": [
        {
          "datasource": {
            "type": "flandersmake-sparql-datasource",
            "uid": "${DS_FLANDERSMAKE-SPARQL-DATASOURCE}"
          },
          "queryText": "PREFIX log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/>\nPREFIX icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/>\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX dct: <http://purl.org/dc/terms/>\nPREFIX data5g: <http://5g4data.eu/5g4data#>\nPREFIX set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/>\nPREFIX quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/>\n\nSELECT DISTINCT \n  (STRAFTER(STR(?intent), \"5g4data#\") AS ?intent_id)\n  (SAMPLE(?intentDesc) AS ?intent_description)\n  (GROUP_CONCAT(DISTINCT ?condition_description; separator=\"; \") AS ?condition_descriptions)\nWHERE {\n  BIND(IRI(CONCAT(\"repository:\", \"${repository_id}\")) AS ?__repository)\n  BIND(IRI(\"${graph_iri}\") AS ?__graph)\n  SERVICE ?__repository {\n    GRAPH ?__graph {\n    BIND(data5g:${intent_id} AS ?intent)\n    ?intent rdf:type ?intentType .\n    OPTIONAL { ?intent dct:description ?intentDesc . }\n\n    OPTIONAL {\n      ?intent log:allOf ?intentAllOf .\n      OPTIONAL { ?intentAllOf rdf:rest*/rdf:first ?intentMember . }\n      BIND(COALESCE(?intentMember, ?intentAllOf) AS ?expectation)\n\n      ?expectation rdf:type ?expectationType .\n      FILTER(CONTAINS(STR(?expectationType), \"Expectation\"))\n\n      OPTIONAL {\n        ?expectation log:allOf ?expectationAllOf .\n        OPTIONAL { ?expectationAllOf rdf:rest*/rdf:first ?expectationMember . }\n        BIND(COALESCE(?expectationMember, ?expectationAllOf) AS ?condition)\n\n        ?condition rdf:type ?conditionType .\n        FILTER(?conditionType IN (icm:Condition, log:Condition))\n        OPTIONAL { ?condition dct:description ?condition_description . }\n      }\n    }\n\n    }}\n}\nGROUP BY ?intent\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Intent Description",
      "type": "table"
    },

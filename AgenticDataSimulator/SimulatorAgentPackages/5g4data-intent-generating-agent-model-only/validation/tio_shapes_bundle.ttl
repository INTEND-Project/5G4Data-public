        sh:name "ontologyNamespace" ;
        sh:datatype xsd:string ;
    ], [
        sh:path tio-lib:targetClass ;
        sh:description "The class to target within the ontology namespace" ;
        sh:name "targetClass" ;
    ] ;
    sh:select """
        SELECT ?this
        WHERE {
            ?this a $targetClass .
            FILTER(STRSTARTS(STR(?this), $ontologyNamespace))
        }
    """ .

# Target nodes that use properties from a specific ontology namespace
tio-targets:VocabularyUsageTargetType
    a rdfs:Class, sh:SPARQLTargetType ;
    rdfs:subClassOf sh:Target ;
    rdfs:label "Vocabulary Usage Target Type" ;

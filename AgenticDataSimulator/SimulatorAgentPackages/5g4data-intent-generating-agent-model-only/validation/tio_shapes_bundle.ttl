# --- tio-shacl/rdf/lib/GlobalShapes.ttl ---
# TMF Global SHACL Shapes
#
# Global validation shapes that apply across ALL TMF ontologies.
# These shapes use SPARQL targets to automatically find and validate instances
# across any ontology without requiring explicit composition.
#

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
